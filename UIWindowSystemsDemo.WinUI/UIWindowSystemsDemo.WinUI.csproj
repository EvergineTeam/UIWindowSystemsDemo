<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>UIWindowSystemsDemo.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Evergine.DirectX11" Version="2026.5.19.266-nightly" />
    <PackageReference Include="Evergine.HLSLEverywhere" Version="2026.5.19.266-nightly" />
    <PackageReference Include="Evergine.XAudio2" Version="2026.5.19.266-nightly" />
    <PackageReference Include="Evergine.WinUI" Version="2026.5.19.266-nightly" />
    <PackageReference Include="Evergine.Targets" Version="2026.5.19.266-nightly" />
    <PackageReference Include="Evergine.Targets.Windows" Version="2026.5.19.266-nightly" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UIWindowSystemsDemo\UIWindowSystemsDemo.csproj" />
  </ItemGroup>
</Project>