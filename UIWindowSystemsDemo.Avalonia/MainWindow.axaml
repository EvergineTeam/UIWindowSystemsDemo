<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UIWindowSystemsDemo.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="UIWindowSystemsDemo.Avalonia.MainWindow"
        Title="UIWindowSystemsDemo.Avalonia"
        Width="1280"
        Height="720">
    <Border Grid.Row="0" 
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                ClipToBounds="True">
          <!-- Evergine Rendering Surface -->
            <local:EvergineControl x:Name="RenderControl"
                                   DisplayTag="DefaultDisplay"/>
        </Border>
</Window>
